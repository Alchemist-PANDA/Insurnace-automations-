# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Postgres ───────────────────────────────────────────────────────────
# Services connect as the RESTRICTED role (RLS is only enforced for a
# non-superuser, non-BYPASSRLS role — see packages/db/src/bootstrap-roles.sql).
DATABASE_URL=postgres://stl_app:stl_app@localhost:5432/stl
# Migrations run as the OWNER (may be superuser). Used by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgres://stl:stl@localhost:5432/stl

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API service ────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# ─── Web app ────────────────────────────────────────────────────────────
WEB_PORT=3000
AUTH_SECRET=dev-only-change-me-in-production-please-32chars

# ─── Encryption (integration credentials at rest) ───────────────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZG8tbm90LXVzZS0h

# ─── Twilio (leave blank to use the fake adapter in dev) ────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ─── LLM provider (leave blank to use the fake adapter in dev) ──────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# ─── Feature flags ──────────────────────────────────────────────────────
# Use in-memory fakes instead of real providers (offline dev / tests)
USE_FAKE_ADAPTERS=true
